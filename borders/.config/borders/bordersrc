#!/bin/bash
# ~/.config/borders/bordersrc — omacos
# Border around the focused window (Omarchy has a plain 2px accent; this is the showy
# version: rounded, 6px, glowing). Colours come from the current theme
# (~/.local/state/omacos/theme/colors.sh, rendered by omacos-theme set); Tokyo Night until then.
# Alternatives for active_color:
#   plain      $ACCENT
#   gradient   "gradient(top_left=$ACCENT,bottom_right=$MAGENTA)"
ACCENT=0xff7aa2f7
MAGENTA=0xffbb9af7
MUTED=0xff3b4261
[ -f "$HOME/.local/state/omacos/theme/colors.sh" ] && . "$HOME/.local/state/omacos/theme/colors.sh"
options=(
  style=round
  width=6.0
  hidpi=on
  active_color="glow($ACCENT)"
  inactive_color=$MUTED
)
borders "${options[@]}"
