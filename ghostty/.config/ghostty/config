# ~/.config/ghostty/config — omacos
# Omarchy's Ghostty look. Reload with cmd+shift+, or restart Ghostty.

font-family = CaskaydiaMono Nerd Font
theme = TokyoNight Night
# omacos-theme set renders the current palette here; it overrides the theme above
config-file = ?~/.local/state/omacos/theme/ghostty.conf
# omacos-font set writes the chosen family here
config-file = ?~/.local/state/omacos/font.conf

# Omarchy: 14px padding, no confirm on close, no resize overlay
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never

# Title bar in the theme's background colour: no traffic lights (Super+W closes), no folder
# icon, title from tmux (set-titles). Only new windows pick a change of the style up. The
# popup and the screensaver keep theirs hidden. No window-title-font-family: Ghostty 1.3.1
# truncates the title after ~10 characters as soon as a custom title font is set.
macos-titlebar-style = transparent
macos-window-buttons = hidden
macos-titlebar-proxy-icon = hidden

# Omarchy's tmux bindings live on Alt (Alt+Enter, Alt+1-9, Alt+arrows) — Option must send Alt.
macos-option-as-alt = true

# Alt+Shift+Enter and Ctrl+Alt+Shift+arrows need the kitty keyboard protocol (tmux: extended-keys csi-u)
