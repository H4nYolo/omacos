# omacos — everything the Omarchy look & feel needs on macOS
# Install with: brew bundle --file=Brewfile

tap "nikitabobko/tap"
tap "FelixKratz/formulae"

# tiling & bar
cask "nikitabobko/tap/aerospace"
brew "FelixKratz/formulae/sketchybar"
brew "FelixKratz/formulae/borders"

# keyboard
cask "karabiner-elements"

# launcher (Omarchy menu / walker) and clean app uninstall
cask "sol"
cask "pearcleaner"

# terminal & shell
cask "ghostty"
brew "tmux"
brew "ncurses"          # tmux-256color terminfo (macOS ncurses is too old)
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "stow"

# omarchy aliases & tools
brew "eza"
brew "fzf"
brew "bat"
brew "zoxide"
brew "jq"
brew "neovim"
brew "lazygit"
brew "lazydocker"

# font
cask "font-caskaydia-mono-nerd-font"
