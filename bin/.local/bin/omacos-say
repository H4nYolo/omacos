#!/bin/sh
# omacos-say [-l lang] [-v voice] [-o file] <text…> — read text out loud through the local
# TTS sidecar (POST {text,lang,voice} -> WAV). Text may also come in on stdin. Without a
# reachable sidecar it falls back to macOS' own `say`, which speaks German too.
# Config: ~/.config/omacos/say-url (default http://127.0.0.1:8880/tts), say-lang, say-voice.
PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
CONF="$HOME/.config/omacos"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/omacos"; mkdir -p "$CACHE"

URL="$(cat "$CONF/say-url" 2>/dev/null)";     URL="${URL:-http://127.0.0.1:8880/tts}"
LANG_="$(cat "$CONF/say-lang" 2>/dev/null)";  LANG_="${LANG_:-en}"
VOICE="$(cat "$CONF/say-voice" 2>/dev/null)"; VOICE="${VOICE:-af_heart}"
out=""

while [ $# -gt 0 ]; do
  case "$1" in
    -l|--lang)  LANG_="$2"; shift 2 ;;
    -v|--voice) VOICE="$2"; shift 2 ;;
    -o|--out)   out="$2"; shift 2 ;;
    -h|--help)  sed -n '2,4p' "$0"; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

text="$*"
[ -n "$text" ] || text="$(cat)"          # no argument: read stdin
[ -n "$text" ] || { echo "usage: omacos-say [-l lang] [-v voice] [-o file] <text…>" >&2; exit 2; }

file="${out:-$CACHE/say.wav}"
# json-escape the text (quotes, backslashes, newlines) without assuming python is around
body="$(printf '%s' "$text" | awk '
  BEGIN { printf "{\"text\":\"" }
  { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); if (NR > 1) printf "\\n"; printf "%s", $0 }
  END { printf "\",\"lang\":\"%s\",\"voice\":\"%s\"}", lang, voice }
' lang="$LANG_" voice="$VOICE")"

code="$(curl -s -m 120 -o "$file" -w '%{http_code}' -X POST "$URL" \
        -H 'Content-Type: application/json' -d "$body" 2>/dev/null)"

if [ "$code" != 200 ]; then
  reason="$(head -c 200 "$file" 2>/dev/null)"
  [ -n "$out" ] || rm -f "$file"
  # 000 = nothing listening; anything else is the sidecar saying no (e.g. unsupported lang)
  echo "omacos-say: sidecar ${code:-unreachable} ${reason}" >&2
  command -v say >/dev/null && exec say "$text"
  exit 1
fi

[ -n "$out" ] && exit 0
afplay "$file"; rm -f "$file"
