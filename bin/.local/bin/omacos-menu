#!/bin/sh
# omacos-menu [route] [--list] — Omarchy's menu as fzf lists in the Popup, driven by
# ~/.config/omacos/menu.json (shared with the native Panel, see docs/adr/0003).
# Backspace on an empty query goes one level up (also out of the pickers), Esc closes.
# `--list` prints the entries of a level as "icon  label<TAB>kind<TAB>value" and exits.
# Routes: root (default) or the id of any submenu (learn, capture, toggle, install, remove, update, info, system).
PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
MENU="$HOME/.config/omacos/menu.json"

# entries <path...>: one line per entry of that level, tab-separated:
# idx  icon  label  kind  value  args  state  when   (kind: menu|view|popup|run; value: id|view|popup name|command)
entries() {
  path='[]'; [ $# -gt 0 ] && path="$(printf '%s\n' "$@" | jq -R . | jq -s -c .)"
  jq -r --argjson path "$path" '
    def at($p): if ($p | length) == 0 then . else (.[] | select(.id == $p[0]) | .menu | at($p[1:])) end;
    .entries | at($path) | to_entries[] | .value as $e |
    [ .key, $e.icon, $e.label,
      (if $e.menu then "menu" elif $e.view then "view" elif $e.popup then "popup" else "run" end),
      ($e.id // $e.view // $e.popup // $e.run // ""), ($e.args // ""), ($e.state // ""), ($e.when // "") ] | @tsv' "$MENU"
}

# resolved <path...>: entries after evaluating `when` (drop) and `state` (append " [out]").
# awk, not `read`: a tab-separated line with empty fields would collapse under IFS.
resolved() {
  entries "$@" | awk -F'\t' -v OFS='\t' '{
    if ($8 != "" && system($8 " >/dev/null 2>&1") != 0) next
    if ($7 != "") { st = ""; ($7 " 2>/dev/null") | getline st; close($7 " 2>/dev/null"); $3 = $3 "  [" st "]" }
    print $1, $2, $3, $4, $5, $6
  }'
}

# run_view <view> <args>: the fzf implementation of a Panel view; status 3 = backspace
run_view() {
  case "$1" in
    launcher)  omacos-launcher $2 ;;
    emoji)     omacos-menu-emoji ;;
    clipboard) omacos-clipboard ;;
    keys)      omacos-keys $2 ;;
    *) echo "omacos-menu: unknown view '$1'" >&2; return 1 ;;
  esac
}

# show <path...>: returns 1 = backspace (go up), 2 = esc (close), 0 = done
show() {
  local title lines sel idx kind value args
  title="${*:-omacos}"; title="${title##* }"
  while true; do
    lines="$(resolved "$@")"
    sel="$(printf '%s\n' "$lines" | awk -F'\t' '{ printf "%s  %s\t%s\n", $2, $3, $1 }' | omacos-fzf --exact --delimiter='\t' --with-nth=1 --nth=1 \
            --prompt="  $title  " --header=' enter  select  ·  backspace  back  ·  esc  close' \
            --bind 'backward-eof:become(echo BACK)')" || return 2
    [ -n "$sel" ] || return 2
    [ "$sel" = BACK ] && return 1
    idx="${sel##*	}"
    line="$(printf '%s\n' "$lines" | awk -F'\t' -v i="$idx" '$1 == i')"
    kind="$(printf '%s' "$line" | cut -f4)"; value="$(printf '%s' "$line" | cut -f5)"; args="$(printf '%s' "$line" | cut -f6)"
    case "$kind" in
      menu)  show "$@" "$value"; [ $? -eq 1 ] && continue; return 0 ;;
      view)  run_view "$value" "$args"; [ $? -eq 3 ] && continue; return 0 ;;
      popup) exec omacos-popup-run "$value" ;;
      run)   omacos-detach sh -c "$value"; return 0 ;;
    esac
  done
}

list=0; route=root
for arg in "$@"; do
  case "$arg" in
    --list) list=1 ;;
    *) route="$arg" ;;
  esac
done
[ "$route" = root ] && set -- || set -- "$route"
if [ $list -eq 1 ]; then
  resolved "$@" | awk -F'\t' '{ printf "%s  %s\t%s\t%s %s\n", $2, $3, $4, $5, $6 }'; exit 0
fi
show "$@"
exit 0
