#!/bin/sh
# omacos-notes [toggle|show|hide|reload] — Notes, the floating markdown scratch pad on Super + Shift + N
# (ADR 0004): one Tab per file in ~/notes/ (folder in ~/.config/omacos/notes-dir), vim keys,
# Typora-style rendering. Talks to the running instance (started by AeroSpace at login) or becomes it.
# Built by shell/build.sh.
exec "$HOME/.local/share/omacos/omacos-notes.app/Contents/MacOS/omacos-notes" "$@"
