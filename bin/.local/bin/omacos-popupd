#!/bin/sh
# omacos-popupd — make sure the omacos popup Ghostty instance is running.
# Called by AeroSpace at startup and by omacos-popup on demand. Idempotent.
PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
pgrep -f 'ghostty --config-file=.*/ghostty/popup' >/dev/null && exit 0
env -u TERM -u TERM_PROGRAM -u TMUX -u TMUX_PANE -u COLORTERM \
  /Applications/Ghostty.app/Contents/MacOS/ghostty --config-file="$HOME/.config/ghostty/popup" >/dev/null 2>&1 &
# give it a moment to register its global hotkey
sleep 1.5
