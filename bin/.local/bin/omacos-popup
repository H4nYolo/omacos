#!/bin/sh
# omacos-popup <launcher|keys> — show an omacos popup in the quick terminal of the
# dedicated popup Ghostty instance (see ~/.config/ghostty/popup). The panel is
# centred on the monitor under the mouse and ignored by AeroSpace, so it appears
# in place without any re-tiling jumps.
PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omacos"
mkdir -p "$STATE_DIR"
printf '%s\n' "${1:-launcher}" > "$STATE_DIR/popup-request"

omacos-popupd
pid="$(pgrep -f 'ghostty --config-file=.*/ghostty/popup' | head -1)"
[ -n "$pid" ] || exit 1

# A previous popup still running (hidden or visible)? Close its surface so the
# next toggle starts a fresh one with the new request — unless it is a brew
# upgrade in progress: never kill that, just bring the panel back.
child="$(pgrep -P "$pid" | head -1)"
if [ -n "$child" ]; then
  if pgrep -P "$child" -f 'brew' >/dev/null 2>&1 || ps -o command= -p $(pgrep -P "$child" 2>/dev/null) 2>/dev/null | grep -q 'brew'; then
    printf 'brew\n' > "$STATE_DIR/popup-request"
  else
    pkill -P "$pid"
    sleep 0.3
  fi
fi

# Fire the popup instance's private global hotkey (ctrl+alt+shift+cmd+F19).
# Right after the instance starts the hotkey may not be registered yet, so
# check that a panel actually appeared and fire once more if it didn't.
toggle() { osascript -e 'tell application "System Events" to key code 80 using {control down, option down, shift down, command down}'; }
shown() { osascript -e "tell application \"System Events\" to tell (first process whose unix id is $pid) to get count of windows" 2>/dev/null; }
toggle
i=0
while [ $i -lt 10 ]; do
  sleep 0.15
  [ "$(shown)" = "1" ] && exit 0
  i=$((i+1))
done
toggle
