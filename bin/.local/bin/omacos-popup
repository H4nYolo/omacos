#!/bin/sh
# omacos-popup <title> <cols> <rows> <command> [args...]
# OMACOS_POPUP_FONT_SIZE=16 in the environment picks a bigger font for the window.
# Opens a Ghostty window of <cols>x<rows> cells, centred on the monitor under the
# mouse, running <command>. AeroSpace floats every window whose title starts
# with "omacos-" (see ~/.aerospace.toml). Used by Super+K (omacos-keys) and friends.
PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
title="$1"; cols="$2"; rows="$3"; shift 3
command -v "$1" >/dev/null || { echo "omacos-popup: $1 not found" >&2; exit 1; }
# Pass the bare name, never a path: macOS reports any argv entry that exists as a file
# to Ghostty as "open this file", and Ghostty then asks "Allow Ghostty to execute ...?".
cmd="$(basename "$1")"
shift
cd "$HOME" || exit 1

# Approximate cell size for the Ghostty font (CaskaydiaMono, default 13pt), plus window padding.
font="${OMACOS_POPUP_FONT_SIZE:-13}"
geometry="$(osascript -l JavaScript - "$cols" "$rows" "$font" <<'JXA'
function run(argv) {
  ObjC.import("AppKit");
  const cols = +argv[0], rows = +argv[1], font = +argv[2];
  const winW = cols * font * 0.6 + 28, winH = rows * font * 1.25 + 28;
  const m = $.NSEvent.mouseLocation;
  const screens = $.NSScreen.screens;
  const mainH = $.NSScreen.screens.objectAtIndex(0).frame.size.height;
  let f = screens.objectAtIndex(0).frame;
  for (let i = 0; i < screens.count; i++) {
    const s = screens.objectAtIndex(i).frame;
    if (m.x >= s.origin.x && m.x < s.origin.x + s.size.width &&
        m.y >= s.origin.y && m.y < s.origin.y + s.size.height) { f = s; break; }
  }
  const x = Math.round(f.origin.x + (f.size.width - winW) / 2);
  const y = Math.round((mainH - (f.origin.y + f.size.height)) + (f.size.height - winH) / 2);
  return [x, y, Math.round(winW), Math.round(winH)].join(" ");
}
JXA
)"
set -- "$geometry" "$cmd" "$@"
x="${1%% *}"; rest="${1#* }"; y="${rest%% *}"; rest="${rest#* }"; w="${rest%% *}"; h="${rest#* }"; shift
cmd="$1"; shift

# Run the Ghostty binary directly (not via `open`, which would also trigger the dialog).
# PATH is inherited through `login -p`, so the bare command name resolves inside Ghostty.
ghostty="/Applications/Ghostty.app/Contents/MacOS/ghostty"
env -u TERM -u TERM_PROGRAM -u TMUX -u TMUX_PANE -u COLORTERM \
  "$ghostty" --title="$title" ${OMACOS_POPUP_FONT_SIZE:+--font-size="$OMACOS_POPUP_FONT_SIZE"} \
    --window-width="$cols" --window-height="$rows" \
    --window-position-x="$x" --window-position-y="$y" \
    -e "$cmd" "$@" >/dev/null 2>&1 &
pid=$!

# Launched directly, Ghostty honours --window-position/size and AeroSpace's title rule
# floats the window. Verify anyway and correct the frame if something re-tiled it.
i=0
while [ $i -lt 30 ]; do
  id="$(aerospace list-windows --monitor all --pid "$pid" --format '%{window-id}' 2>/dev/null | head -1)"
  [ -n "$id" ] && break
  sleep 0.1; i=$((i+1))
done
[ -n "$id" ] || exit 0
aerospace layout floating --window-id "$id" >/dev/null 2>&1

frame() {
  osascript -e "tell application \"System Events\" to tell (first process whose unix id is $pid) to get {position, size} of window 1" 2>/dev/null
}
place() {
  osascript -e "tell application \"System Events\" to tell (first process whose unix id is $pid)
    set size of window 1 to {$w, $h}
    set position of window 1 to {$x, $y}
  end tell" >/dev/null 2>&1
}
i=0
while [ $i -lt 6 ]; do
  sleep 0.2
  [ "$(frame)" = "$x, $y, $w, $h" ] && exit 0
  place
  i=$((i+1))
done
