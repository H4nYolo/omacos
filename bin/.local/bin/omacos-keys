#!/bin/sh
# omacos-keys — searchable list of every omacos keybinding (Omarchy's Super+K).
# Reads the bindings and their comments straight from ~/.aerospace.toml, adds the
# tmux bindings, and shows everything in fzf. Super+K shows both, `omacos-keys tmux`
# (Super+Shift+K) only tmux, `omacos-keys aerospace` only the window manager,
# `omacos-keys shell` the aliases, tmux layouts (tdl/ix/…) and omacos-* commands,
# `omacos-keys btop` the keys inside btop (Super+Shift+A), `omacos-keys notes` the keys inside Notes
# (Super+Shift+N).
# `--list` prints the lines instead of opening fzf (the native Panel reads them).
PATH="/opt/homebrew/bin:$PATH"
only=all; list=0
for arg in "$@"; do case "$arg" in --list) list=1 ;; *) only="$arg" ;; esac; done
CFG="$HOME/.aerospace.toml"

aerospace_keys() {
  awk '
    BEGIN {
      names["backtick"]="`"; names["minus"]="-"; names["equal"]="="; names["slash"]="/"; names["semicolon"]=";"
      names["enter"]="Enter"; names["backspace"]="Backspace"; names["esc"]="Esc"; names["tab"]="Tab"
      names["left"]="Left"; names["right"]="Right"; names["up"]="Up"; names["down"]="Down"
      names["home"]="Home"; names["end"]="End"; names["shift"]="Shift"; names["ctrl"]="Ctrl"; names["alt"]="Alt"; names["cmd"]="Cmd"
    }
    /^\[mode\.[a-z]+\.binding\]/ { mode=$0; sub(/^\[mode\./,"",mode); sub(/\.binding\].*/,"",mode); next }
    mode != "" && /^[[:space:]]*[a-z0-9-]+[[:space:]]*=/ {
      line=$0
      key=line; sub(/^[[:space:]]*/,"",key); sub(/[[:space:]]*=.*/,"",key)
      rest=line; sub(/^[^=]*=[[:space:]]*/,"",rest)
      desc=""
      if (match(rest, /[[:space:]]+#[[:space:]]*/)) { desc=substr(rest, RSTART+RLENGTH); rest=substr(rest, 1, RSTART-1) }
      gsub(/^[\x27\[]+|[\x27\]]+$/, "", rest); gsub(/\x27, \x27/, " · ", rest)
      gsub(/ctrl-alt-cmd-shift/, "Super+Shift", key)
      gsub(/ctrl-alt-cmd/, "Super", key)
      n = split(key, parts, "-"); key = ""
      for (i = 1; i <= n; i++) {
        t = parts[i]
        if (t in names) t = names[t]
        else if (length(t) == 1) t = toupper(t)
        key = key (i > 1 ? "+" : "") t
      }
      if (desc == "") desc = rest
      prefix = (mode == "main") ? "" : "[" mode "] "
      printf "%-30s %s\n", prefix key, desc
    }
  ' "$CFG"
}

tmux_keys() {
  tmux list-keys -T root 2>/dev/null | awk '{ key=$4; $1=$2=$3=$4=""; sub(/^ +/,""); printf "%-30s %s\n", "tmux " key, $0 }'
  tmux list-keys -T prefix 2>/dev/null | awk '{ key=$4; $1=$2=$3=$4=""; sub(/^ +/,""); printf "%-30s %s\n", "tmux Prefix " key, $0 }'
}

# Notes (omacos-notes, ADR 0004): its own shortcuts plus the vim subset of the vendored engine
notes_keys() {
  awk -F'\t' '{ printf "%-30s %s\n", "notes " $1, $2 }' <<'KEYS'
Super+Shift+N	show and focus · focus · hide (Notes)
Cmd+Enter	back to the previous app, Notes stays on screen
Cmd+T	new Tab (asks for the name, creates ~/notes/<name>.md, you type right away)
Cmd+W	close the Tab (the file stays; Cmd+P brings it back)
Cmd+1 … Cmd+9	go to Tab 1 … 9
Ctrl+Tab / Ctrl+Shift+Tab	next / previous Tab
Cmd+P	search Tab names and every line, Enter jumps there
Cmd+E	edit the Tab in real nvim in the Popup
Cmd+Shift+D	insert a timestamp heading
Cmd+Shift+X	tick / untick the task on this line, or make the line a task
/t + space	at the start of a line: - [ ]  (a task)
/h + space	at the start of a line: ## (a heading)
/d + space	at the start of a line: a timestamp heading
Enter	on a task / bullet / numbered line: continues the list; on an empty marker: ends it
Cmd+Plus / Cmd+Minus	opacity with focus
Cmd+Opt+Plus / Cmd+Opt+Minus	opacity without focus (previewed)
double-click Tab	rename · right-click: close, move to Trash · drag: reorder
click a checkbox	toggle it · Cmd+click a link opens it
Esc / i a o O	vim: normal mode / insert (NORMAL/INSERT bottom right)
h j k l w b e 0 $ gg G	vim motions, f t % { } too, counts work
d c y + motion, dd yy p	vim operators; y and p use the system clipboard
v V	visual / visual line
/ n N	search in the Tab
u Ctrl+R .	undo, redo, repeat
:w :q	save now · hide Notes
KEYS
}

# btop 1.4.7's own help table (src/btop_menu.cpp), with vim_keys = true from our btop.conf:
# h/j/k/l/g/G move, so help and kill move to Shift+H and Shift+K
btop_keys() {
  awk -F'\t' '{ printf "%-30s %s\n", "btop " $1, $2 }' <<'KEYS'
Esc, m	main menu
?, F1, Shift+H	help (all keys)
o, F2	options
q, Ctrl+C	quit
p / Shift+P	next / previous layout preset
1 2 3 4 5	toggle CPU / MEM / NET / PROC / GPU box
d	toggle disks in the MEM box
i	disk io mode with big graphs
+, -	update interval +/- 100 ms
Ctrl+R	reload config from disk
j/k, Up/Down	select process
g / G, Home / End	first / last page of processes
PgUp, PgDn	one page up / down
h/l, Left/Right	previous / next sort column
r	reverse sort order
Enter	details of the selected process
f, /	filter processes (start with ! for regex)
Delete	clear the filter
F	follow the selected process
u	pause the process list
e	tree view
E	collapse / expand all in tree view
Space	expand / collapse selected in tree view
C	expand / collapse the selected process' children
c	per-core cpu usage of processes
%	memory display mode in the process box
t	terminate selected process (SIGTERM)
Shift+K	kill selected process (SIGKILL)
s	send any signal to the selected process
N	new nice value for the selected process
b, n	previous / next network device
z	reset totals of the network device
a	auto scaling of the network graphs
y	synced scaling of the network graphs
KEYS
}

# every alias of the shell (Omarchy's, oh-my-zsh's, yours; ~/.zshrc is sourced non-interactively,
# an interactive zsh would grab the popup's tty and abort fzf), the documented tmux layout
# functions from ~/.config/zsh/omarchy.zsh, the tools from the Brewfile (~/.config/omacos/tools.tsv)
# and every omacos-* command
shell_keys() {
  zsh -c 'source ~/.zshrc >/dev/null 2>&1; alias' </dev/null 2>/dev/null | sed -e "s/'\\\\'\$/'\\\\'''/" -e "s/'\\\\''/'/g" | awk -v cfg="$HOME/.config/zsh/omarchy.zsh" '
    BEGIN {
      # trailing "# comment" on an alias line in omarchy.zsh becomes its description
      while ((getline line < cfg) > 0) {
        if (line ~ /^[[:space:]]*alias [A-Za-z_.]+=.*#/) {
          n=line; sub(/^[[:space:]]*alias /, "", n); sub(/=.*/, "", n)
          d=line; sub(/.*[[:space:]]#[[:space:]]*/, "", d); desc[n]=d
        }
      }
    }
    {
      name=$0; sub(/=.*/, "", name)
      cmd=$0; sub(/^[^=]*=/, "", cmd)
      gsub(/^\x27|\x27$/, "", cmd)
      sub(/^printf "[^"]*" && /, "", cmd)
      if (name in desc) cmd=desc[name] "  (" cmd ")"
      printf "%-30s %s\n", "shell " name, cmd
    }'
  echo
  awk '/^# [a-z]+ (<|\[).*  [–-] / {
      d=$0; sub(/^# /, "", d)
      usage=d; sub(/  [–-] .*/, "", usage)
      desc=d; sub(/^.*  [–-] /, "", desc)
      printf "%-30s %s\n", "shell " usage, desc
    }' "$HOME/.config/zsh/omarchy.zsh"
  echo
  awk -F'\t' '{ printf "%-30s %s\n", "tool " $1, $2 }' "$HOME/.config/omacos/tools.tsv" 2>/dev/null
  echo
  for f in "$HOME"/.local/bin/omacos-*; do
    [ -x "$f" ] || continue
    desc="$(sed -n 2p "$f" | sed 's/^# *//; s/^omacos-[a-z-]* *//; s/^— *//')"
    printf "%-30s %s\n" "$(basename "$f")" "$desc"
  done
}

{
  echo "Super = Caps Lock held · Super+Shift = Caps Lock + Shift · tmux Prefix = Ctrl+Space · shell/tool = type it in a terminal"
  echo
  [ "$only" = all ] || [ "$only" = aerospace ] && aerospace_keys
  [ "$only" = all ] && echo
  [ "$only" = all ] || [ "$only" = tmux ] && tmux_keys
  [ "$only" = all ] && echo
  [ "$only" = all ] || [ "$only" = shell ] && shell_keys
  [ "$only" = all ] && echo
  [ "$only" = all ] || [ "$only" = btop ] && btop_keys
  [ "$only" = all ] && echo
  [ "$only" = all ] || [ "$only" = notes ] && notes_keys
} | if [ "$list" -eq 1 ]; then cat; exit 0; else omacos-fzf --exact --prompt='  ' --header-lines=2 \
        --bind 'esc:abort,enter:abort,backward-eof:become(echo BACK)' | grep -qx BACK && exit 3; fi
exit 0
