#!/usr/bin/env sh
# ~/.config/yabai/yabairc
# Omarchy (Hyprland dwindle) -> yabai
#
# Scripting Addition (für space --focus, window --space, sticky, etc.):
#   SIP teilweise deaktivieren, dann `sudo yabai --load-sa` – siehe README.
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# Layout: Hyprland "dwindle" entspricht yabai "bsp" mit auto_balance aus
yabai -m config layout                       bsp
yabai -m config auto_balance                 off
yabai -m config split_ratio                  0.50
yabai -m config window_placement             second_child   # neues Fenster rechts/unten wie dwindle

# Gaps (Omarchy: gaps_in 5 / gaps_out 10)
yabai -m config window_gap                   10
yabai -m config top_padding                  10
yabai -m config bottom_padding               10
yabai -m config left_padding                 10
yabai -m config right_padding                10

# Fenster
yabai -m config window_shadow                off
yabai -m config window_opacity               off
yabai -m config window_zoom_persist          on
yabai -m config insert_feedback_color        0xff7aa2f7

# Maus (Omarchy: Super + Linksklick = verschieben, Super + Rechtsklick = resize)
yabai -m config mouse_modifier               alt
yabai -m config mouse_action1                move
yabai -m config mouse_action2                resize
yabai -m config mouse_drop_action            swap
yabai -m config focus_follows_mouse          off
yabai -m config mouse_follows_focus          off

# Fenster, die floaten sollen (entspricht Omarchys windows.conf)
yabai -m rule --add app="^System Settings$"   manage=off
yabai -m rule --add app="^Systemeinstellungen$" manage=off
yabai -m rule --add app="^Calculator$"        manage=off
yabai -m rule --add app="^Rechner$"           manage=off
yabai -m rule --add app="^Finder$" title="^(Copy|Info|Öffnen|Move|Bin)" manage=off
yabai -m rule --add app="^Archive Utility$"   manage=off
yabai -m rule --add app="^1Password$"         manage=off
yabai -m rule --add app="^Activity Monitor$"  manage=off
yabai -m rule --add app="^Aktivitätsanzeige$" manage=off
yabai -m rule --add title="^(Open|Save|Öffnen|Sichern|Speichern)" manage=off

# Space 10 dient als Scratchpad (Super + S / Super + Alt + S in skhdrc)
yabai -m space 10 --label scratch 2>/dev/null

echo "yabai configuration loaded"
