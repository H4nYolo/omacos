# ~/.config/skhd/skhdrc
# Omarchy Hyprland-Tiling-Hotkeys -> yabai/skhd
#
# Modifier-Mapping (Omarchy -> Mac):
#   SUPER         -> hyper (Caps Lock via Karabiner = ⇧⌘⌥⌃)
#   SUPER + SHIFT -> meh   (rechte ⌘ via Karabiner = ⌃⌥⇧)
#   SUPER + ALT / SUPER + CTRL -> nicht abbildbar, wichtige Funktionen auf freie Hyper/Meh-Tasten gelegt
#   ALT           -> alt (Option), kollidiert nicht mit tmux, da Super nicht auf Option liegt
#
# Hyper + Space bleibt frei für Raycast (= Omarchy-Menü).
# Tasten-Codes: 0x1B = "-"   0x18 = "="   0x32 = "`"   0x2C = "/"   delete = Backspace

# ============================================================== Fenster
hyper - w : yabai -m window --close                                   # Super + W  Close
hyper - q : yabai -m window --close                                   # Super + Q  Close
hyper - t : yabai -m window --toggle float --grid 4:4:1:1:2:2         # Super + T  Toggle float
hyper - j : yabai -m window --toggle split                            # Super + J  Toggle split
hyper - o : yabai -m window --toggle sticky && yabai -m window --toggle float   # Super + O  Sticky'n'float
hyper - l : yabai -m space --layout "$(yabai -m query --spaces --space | jq -r 'if .type == "bsp" then "stack" else "bsp" end')"   # Super + L  Layout (bsp <-> stack)
hyper - f : yabai -m window --toggle zoom-fullscreen                  # Super + F  Fullscreen
meh   - z : yabai -m window --toggle zoom-parent                      # Super + Alt + F  Full width   (verlegt)
hyper - z : yabai -m window --toggle native-fullscreen                # Super + Ctrl + F Native fullscreen (verlegt)
meh   - delete : yabai -m space --toggle padding && yabai -m space --toggle gap   # Super + Shift + Backspace  Gaps

# ============================================================== Fokus / Swap
hyper - left  : yabai -m window --focus west  || yabai -m display --focus west    # Super + Arrow
hyper - right : yabai -m window --focus east  || yabai -m display --focus east
hyper - up    : yabai -m window --focus north || yabai -m display --focus north
hyper - down  : yabai -m window --focus south || yabai -m display --focus south

meh - left  : yabai -m window --swap west                            # Super + Shift + Arrow  Swap
meh - right : yabai -m window --swap east
meh - up    : yabai -m window --swap north
meh - down  : yabai -m window --swap south

# ============================================================== Resize (100px; Alt/Ctrl-Stufen entfallen)
hyper - 0x1B : yabai -m window --resize left:-100:0   || yabai -m window --resize right:100:0    # Super + Minus  expand left
hyper - 0x18 : yabai -m window --resize left:100:0    || yabai -m window --resize right:-100:0   # Super + Equal  shrink left
meh   - 0x1B : yabai -m window --resize bottom:0:-100 || yabai -m window --resize top:0:100      # Super + Shift + Minus  shrink up
meh   - 0x18 : yabai -m window --resize bottom:0:100  || yabai -m window --resize top:0:-100     # Super + Shift + Equal  expand down
hyper - home : yabai -m space --balance                                                          # Ersatz für save/restore width

# ============================================================== Workspaces
hyper - 1 : yabai -m space --focus 1                                  # Super + 1-9  Jump
hyper - 2 : yabai -m space --focus 2
hyper - 3 : yabai -m space --focus 3
hyper - 4 : yabai -m space --focus 4
hyper - 5 : yabai -m space --focus 5
hyper - 6 : yabai -m space --focus 6
hyper - 7 : yabai -m space --focus 7
hyper - 8 : yabai -m space --focus 8
hyper - 9 : yabai -m space --focus 9
hyper - 0 : yabai -m space --focus recent                             # Super + Ctrl + Tab  Former workspace (verlegt)

hyper - tab : yabai -m space --focus next || yabai -m space --focus first   # Super + Tab  Next
meh   - tab : yabai -m space --focus prev || yabai -m space --focus last    # Super + Shift + Tab  Prev

meh - 1 : yabai -m window --space 1 && yabai -m space --focus 1       # Super + Shift + 1-9  Move window + follow
meh - 2 : yabai -m window --space 2 && yabai -m space --focus 2
meh - 3 : yabai -m window --space 3 && yabai -m space --focus 3
meh - 4 : yabai -m window --space 4 && yabai -m space --focus 4
meh - 5 : yabai -m window --space 5 && yabai -m space --focus 5
meh - 6 : yabai -m window --space 6 && yabai -m space --focus 6
meh - 7 : yabai -m window --space 7 && yabai -m space --focus 7
meh - 8 : yabai -m window --space 8 && yabai -m space --focus 8
meh - 9 : yabai -m window --space 9 && yabai -m space --focus 9

# Scratchpad = Space "scratch" (Space 10, siehe yabairc)
hyper - s    : [ "$(yabai -m query --spaces --space | jq -r .label)" = "scratch" ] && yabai -m space --focus recent || yabai -m space --focus scratch   # Super + S
hyper - 0x32 : [ "$(yabai -m query --spaces --space | jq -r .label)" = "scratch" ] && yabai -m space --focus recent || yabai -m space --focus scratch   # Super + `
meh   - s    : yabai -m window --space scratch                        # Super + Alt + S  Move to scratchpad (verlegt)
meh   - 0x32 : yabai -m window --space scratch                        # Super + Shift + `

# Monitore
meh - home : yabai -m space --display west                            # Super + Shift + Alt + Left   Workspace auf linken Monitor (verlegt)
meh - end  : yabai -m space --display east                            # Super + Shift + Alt + Right  Workspace auf rechten Monitor (verlegt)
ctrl + alt - tab         : yabai -m display --focus next || yabai -m display --focus first   # Ctrl + Alt + Tab  Cycle monitors
ctrl + alt + shift - tab : yabai -m display --focus prev || yabai -m display --focus last

# Alt + Tab  Cycle windows on workspace (funktioniert auch innerhalb eines Stacks)
alt - tab         : yabai -m window --focus next || yabai -m window --focus first
alt + shift - tab : yabai -m window --focus prev || yabai -m window --focus last

# ============================================================== Gruppen (Hyprland groups ~ yabai stacks)
hyper - g : yabai -m space --layout "$(yabai -m query --spaces --space | jq -r 'if .type == "stack" then "bsp" else "stack" end')"   # Super + G  Toggle group
meh   - g : yabai -m window --toggle float && yabai -m window --toggle float   # Super + Alt + G  Move out of group (verlegt)
hyper - 0x2C : yabai -m window --focus stack.next || yabai -m window --focus stack.first   # Super + Alt + Tab  Next in group (verlegt auf Super + /)
# Super + Alt + Arrow (Fenster in Gruppe schieben) -> nicht belegt

# ============================================================== Apps starten
hyper - return : open -na Ghostty                                     # Super + Return  Terminal
meh   - return : open -na "Google Chrome"                             # Super + Shift + Return  Browser
meh   - t : open -na Ghostty --args -e zsh -lic "tmux attach || tmux new -s Work"   # Super + Alt + Return  Tmux terminal (verlegt)
meh   - b : open -na "Google Chrome"                                  # Super + Shift + B  Browser
meh   - f : open -a Finder ~                                          # Super + Shift + F  Files
meh   - n : open -na Ghostty --args -e nvim                           # Super + Shift + N  Editor
meh   - d : open -na Ghostty --args -e lazydocker                     # Super + Shift + D  Docker
hyper - b : open -na Ghostty --args -e btop                           # Super + Ctrl + T  Activity (verlegt)
meh   - m : open -a Spotify                                           # Super + Shift + M  Music
meh   - o : open -a Obsidian                                          # Super + Shift + O  Obsidian
meh   - i : open -a Signal                                            # Super + Shift + G  Signal (verlegt auf I, G = out of group)
meh   - 0x2C : open -a 1Password                                      # Super + Shift + /  Passwords
meh   - l : osascript -e 'tell application "System Events" to keystroke "q" using {control down, command down}'   # Super + Ctrl + L  Lock (verlegt)

# hyper - space  -> Raycast (in Raycast selbst gesetzt, hier nicht binden)
# Super + Escape  System menu -> kein Äquivalent
